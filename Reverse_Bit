#include <iostream>
using namespace std;

class Solution{
    public:
    int reversebit(int n){
        int ans=0;
        for(int i=0; i<32; i++){
            ans=(ans<<1)|(n&1);
            n>>=1;
        }
        return ans;
    }
};
int main()
{    //43261596
    int x,y;
    cin>>x;
    Solution obj;
    cout<<" Reverse Bit = "<<obj.reversebit(x)<<endl;

    return 0;
}
