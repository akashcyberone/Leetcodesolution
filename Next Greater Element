#include <bits/stdc++.h>
using namespace std;

vector<int>nextgreater(vector<int>arr){
    stack<int>st;
    vector<int>ans(arr.size());
    for(int i=arr.size()-1; i>=0; i--){
        while(st.size()>0 && st.top()<=arr[i]){
            st.pop();
        }
        if(st.empty()){
            ans[i]=-1;
        }else{
            ans[i]=st.top();
        }
        st.push(arr[i]);
    }
    return ans;
}
int main() {
    int n;
    cin>>n; 
    vector<int>p(n);
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    vector<int>ans=nextgreater(p);
    for(auto val:ans){
        cout<<val<<" ";
    }
    return 0;
}
