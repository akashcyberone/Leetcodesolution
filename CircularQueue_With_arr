#include <iostream>
using namespace std;

class circularqueue{  //O(1)
    int* arr;
    int currsize,cap;
    int f,r;
 public:
    circularqueue(int size){   //O(1)
        cap=size;
        arr=new int[cap];
        currsize=0;
        f=0;
        r=-1;
    }
    void push(int data){  //O(1)
        if(currsize==cap){
            cout<<"CQ id full\n";
            return;
        }
        r=(r+1)%cap;
        arr[r]=data;
        currsize++;
    }
    void pop(){     //O(1)
        if(empty()){
            cout<<"CQ is empty";
            return;
        }
        f=(f+1)%cap;
        currsize--;
    }
    int front(){  //O(1)
        if(empty()){
            cout<<"CQ id empty";
            return -1;
        }
        return arr[f];
    }
    bool empty(){  //O(1)
            return currsize==0;
        }
    void print(){
        for(int i=0; i<currsize; i++){
            cout<<arr[i]<<" ";
        }
        cout<<endl;
    }
    };
int main()
{
    circularqueue cq(3);
    cq.push(1);
    cq.push(2);
    cq.push(3);
    cq.pop();
    cq.push(4);
    cq.print();
    while(!cq.empty()){
        cout<<cq.front()<<" ";
        cq.pop();
    }
    
    return 0;
}
