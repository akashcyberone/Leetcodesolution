#include <iostream>
#include <vector>
using namespace std;

int lift_problem(vector<int> wt, int k) {
    int c = 0;
    int s = 0;
    for (int i = 0; i < wt.size(); i++) {
         s+=wt[i];
        if (s  < k) {
            s += wt[i];
            c++;
        } else {
            break;
        }
    }
    return c;
}

int main() {
    int n, k;
    cin >> n >> k;
    vector<int> p(n);

    for (int i = 0; i < n; i++) {
        cin >> p[i];
    }

    cout << lift_problem(p, k) << endl;

    return 0;
}
