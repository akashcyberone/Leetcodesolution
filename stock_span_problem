#include <bits/stdc++.h>
using namespace std;

vector<int>stockspan(vector<int>price){
    vector<int>ans(price.size());
    stack<int>st;
    for(int i=0; i<price.size(); i++){
        while(!st.empty()>0 && price[st.top()]<=price[i]){
            st.pop();
        }
        if(st.empty()){
            ans[i]=i+1;
        }else{
            ans[i]=i-st.top();
        }
        st.push(i);
    }
    return ans;
}
int main()
{
    int n;
    cin>>n;
    vector<int>p(n);
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    vector<int>ans=stockspan(p);
    for(auto val:ans){
        cout<<val<<" ";
    }
    return 0;
}
