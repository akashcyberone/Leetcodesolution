bool frequency_P(string &s1,string &s2){
    
    return s1.size()<s2.size(); // Sort by increasing order
}
int stringlen(string s){
    vector<string>v;
    stringstream ss(s);
    string p="";
    while(ss>>p)
        v.push_back(p);
    return v.size();
}
string maximum_s_word(string s){
    vector<string>v;
    stringstream ss(s);
    string p="";
    while(ss>>p)
    v.push_back(p);
    
    string res="";
    int m=0;
    for(auto k:v){
        if(m<k.size()){
            m=k.size();
            res=k;
        }
    }
    return res;
}
string smallest_s(string s){
    vector<string>v;
    stringstream ss(s);
    string p="";
    while(ss>>p)
    v.push_back(p);
    int m=INT_MAX; string ans="";
    for(auto k:v){
        if(m>k.size()){
            m=k.size();
            ans=k;
        }
    }
    return ans;
}
string rev(string s) {
    stringstream ss(s);
    vector<string> v;
    string word;

    while (ss >> word) {
        v.push_back(word);
    }
    reverse(v.begin(), v.end());

    string ans = "";

    for (auto word : v) {
        ans += word + " ";
    }

    return ans;
}
string longest_word(string s){
    vector<string>v;
    stringstream ss(s);
    string p="";
    while(ss>>p)
    v.push_back(p);
    sort(v.begin(),v.end(),frequency_P);
    for(auto k:v){
        return k;
    }
}

