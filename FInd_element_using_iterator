#include <bits/stdc++.h>
using namespace std;

int s_sm(vector<int>&arr,int x){
    set<int>s;
    for(auto k:arr){
        s.insert(k);
    }
    auto it=s.find(x);
    if(it!=s.end()){
        auto nextit=prev(it);
        if(nextit!=s.end()){
            return *nextit;
        }
    }
    return -1;
}
int main()
{
    int n,x;
    cin>>n>>x;
    vector<int>p(n);
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    cout<<s_sm(p,x)<<" ";
    
    return 0;
}
