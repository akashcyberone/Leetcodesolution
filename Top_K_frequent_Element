#include <bits/stdc++.h>
using namespace std;

bool compaire(pair<int,int>&a,pair<int,int>&b){
    return a.second>b.second;
}
vector<int>freqT_top(vector<int>&arr,int b){
    vector<int>ans;
    unordered_map<int,int>mp;
    for(auto k:arr){
        mp[k]++;
    }
    vector<pair<int,int>>v;
    for(auto k:mp){
        v.push_back({k.first,k.second});
    }
    sort(v.begin(),v.end(),compaire);
        for(int i=0; i<b; i++){
            ans.push_back(v[i].first);
    }
    return ans;
}
int main()
{   
    int n,a;
    cin>>a>>n;
    vector<int>p(n);
    vector<int>ans;
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    ans=freqT_top(p,a);
    for(auto k:ans){
        cout<<k<<" ";
    }
    return 0;
}
