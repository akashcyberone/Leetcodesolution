#include <bits/stdc++.h>
using namespace std;

int findsecondlargest(vector<int>arr){
    int mx=*max_element(arr.begin(),arr.end());
    arr.erase(remove(arr.begin(),arr.end(),mx),arr.end());
    int smx=*max_element(arr.begin(),arr.end());
    return smx;
}
int main()
{
    int n;
    cin>>n;
    vector<int>p(n);
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    cout<<"Second Largest = "<<findsecondlargest(p);
    return 0;
}
