#include <bits/stdc++.h>
using namespace std;

int sumsquare(int n){
    int sum=0;
    while(n>0){
        int dig=n%10;
        sum+=dig*dig;
        n/=10;
    }
    return sum;
}
bool ishappy(int n){
    unordered_set<int>seen;
    while(n!=1){
        if(seen.count(n))
            return false;
        seen.insert(n);
        n=sumsquare(n);
    }
    return true;
}
int main()
{
    int n;
    cin>>n;
    if(ishappy(n))
    cout<<"Happy Number";
    else
    cout<<"Not a Happy Number";
    return 0;
}
