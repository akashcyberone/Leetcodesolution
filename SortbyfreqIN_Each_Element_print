#include <bits/stdc++.h>
using namespace std;

static bool comapire(pair<int,int>&a,pair<int,int>&b){
    return a.second<b.second;
}
vector<int>sortbyfreq(vector<int>&arr){
    vector<int>ans;
    map<int,int>mp;
    for(auto k:arr){
        mp[k]++;
    }
    vector<pair<int,int>>v;
    for(auto x:mp){
        v.push_back({x.first,x.second});
    }
    sort(v.begin(),v.end(),comapire);
    for(auto k:v){
        for(int i=0; i<k.second; i++){
            ans.push_back(k.first);
        }
    }
    return ans;
}
int main()
{   
    int n;
    cin>>n;
    vector<int>p(n);
    vector<int>ans;
    for(int i=0; i<n; i++){
        cin>>p[i];
    }
    ans=sortbyfreq(p);
    for(auto k:ans){
        cout<<k<<" ";
    }
    return 0;
}
