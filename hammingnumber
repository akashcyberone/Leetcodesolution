#include <iostream>
using namespace std;

class Solution{
    public:
    int hammingdistance(int x,int y){
        int xr=x^y;
        int c=0;
        while(xr!=0){
            c+=xr&1;
            xr>>=1;
        }
        return c;
    }
};
int main()
{
    int x,y;
    cin>>x>>y;
    Solution obj;
    cout<<" hammingdistance = "<<obj.hammingdistance(x,y)<<endl;

    return 0;
}
