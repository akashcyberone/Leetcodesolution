#include <bits/stdc++.h>
using namespace std;

struct ListNode{
    int val;
    ListNode* next;
    
    ListNode(int x){
        val=x;
        next=NULL;
    }
};
class Solution {
public:
    ListNode* reverseList(ListNode* head) {

    ListNode* prev=NULL;
    ListNode* curr=head;
    ListNode* next=NULL;
    
    while(curr!=NULL){
        next=curr->next;
        curr->next=prev;
        prev=curr;
        curr=next;
    }
    return prev;
    }
};

void plist(ListNode* head){
    while(head!=NULL){
        cout<<head->val<<"->";
        head=head->next;
    }
    cout<<"NULL"<<endl;
}

int main()
{
    int n;
    cout<<" Enter the list Node";
    cin>>n;
    
    ListNode* head=NULL;
    ListNode* tail=NULL;
    
    cout<<"Enter the list elements : ";
    
    for(int i=0; i<n; i++){
        int x;
        cin>>x;
        
        ListNode* newNode= new ListNode(x);
        if(head==NULL){
            head=tail=newNode;
        }else{
            tail->next=newNode;
            tail=newNode;
        }
    }
    Solution obj;
    cout<<"Original List : ";
    plist(head);
    
    head=obj.reverseList(head);
    cout<<" Reversed LinkList : ";
    plist(head);
    return 0;
}
